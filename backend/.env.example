# MIRRORWORLD backend configuration — copy to `backend/.env` and edit there.
#
# `backend/app/env.py` parses this file at startup, so a value added here takes
# effect on the next API restart. A real environment variable always wins over
# the file.
#
# No key ever reaches the frontend, the build output or the logs. Leave
# MIRROR_AI_API_KEY unset to run Mirror AI in deterministic mode (answers come
# from the rule engine and say so).

# Provider id. Only `google` is implemented today; a second provider can be
# added behind the same ask() contract.
MIRROR_AI_PROVIDER=google

# Google AI Studio key. Without it Mirror AI still answers, using deterministic
# campus data, and labels every answer as rule-engine output.
# Get one at https://aistudio.google.com/apikey
MIRROR_AI_API_KEY=

# Primary model id. Must be a model your key can actually use; a wrong id
# returns the provider's own error and Mirror AI falls back rather than
# pretending a model answered.
MIRROR_AI_MODEL=gemini-2.5-flash

# Optional second model tried when the primary is unavailable.
MIRROR_AI_FALLBACK_MODEL=

# Transport tuning (seconds / attempts).
MIRROR_AI_TIMEOUT=30
MIRROR_AI_MAX_RETRIES=1

# Provider endpoint. Override only for a compatible gateway.
MIRROR_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemma ids hosted by the Gemini API: gemma-4-26b-a4b-it (26B total, ~4B active)
# and gemma-4-31b-it. Gemma 3 and older need their system prompt inlined.
